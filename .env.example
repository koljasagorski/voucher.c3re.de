# Copy to .env and fill in. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=voucher.example.de
SITE_URL=https://voucher.example.de
# Behind the reverse proxy: take the client IP from X-Forwarded-For (for rate limits).
USE_X_FORWARDED_FOR=1

# --- Database (docker-compose service "db") ---
POSTGRES_DB=voucher
POSTGRES_USER=voucher
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://voucher:change-me@db:5432/voucher

# --- Outgoing mail (SMTP) ---
EMAIL_HOST=mail.example.de
EMAIL_PORT=587
EMAIL_HOST_USER=voucher@example.de
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Voucher-Warteliste <voucher@example.de>
# Comma-separated; receive quarantine/no_code/invalid/deadline alerts.
ADMIN_EMAILS=orga@example.de

# --- Incoming mail (IMAP) ---
IMAP_HOST=mail.example.de
IMAP_USER=voucher@example.de
IMAP_PASSWORD=change-me
IMAP_FOLDER=INBOX
# Address users enter in the shop for the follow-up voucher (default: IMAP_USER).
VOUCHER_INBOX_ADDRESS=voucher@example.de

# --- Voucher mail parsing ---
# Comma-separated addresses (with @) or domains (without @).
VOUCHER_ALLOWED_SENDERS=tickets.events.ccc.de
# Fallback code pattern if no tickets.events.ccc.de link with voucher= is found.
# Default (pretix): \b[A-Z0-9]{16}\b
# VOUCHER_CODE_REGEX=
# authserv-id of OUR mail server in the Authentication-Results header.
VOUCHER_AUTHSERV_ID=mail.example.de
